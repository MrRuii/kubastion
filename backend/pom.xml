<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>io.kubastion</groupId>
    <artifactId>kubastion-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>kubastion-backend</name>
    <description>Drives kubectl on a jump host over SSH and streams pod state to the UI</description>

    <licenses>
        <license>
            <name>PolyForm Shield License 1.0.0</name>
            <url>https://polyformproject.org/licenses/shield/1.0.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- A real pseudo-terminal. Without it, interactive gateway menus and
             prompts do not behave as they do in a real terminal.
             Uses ConPTY on Windows. It is the library behind IntelliJ's terminal. -->
        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>0.12.13</version>
            <exclusions>
                <!-- purejavacomm is for serial ports, not PTYs, and it is not
                     published to Maven Central. Without this exclusion the build
                     would need the JetBrains repository, which is often blocked in
                     corporate networks — precisely where this project has to run. -->
                <exclusion>
                    <groupId>org.jetbrains.pty4j</groupId>
                    <artifactId>purejavacomm</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- No Lombok: the model uses Java 21 records.
             One less dependency to fight with the JDK version. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
